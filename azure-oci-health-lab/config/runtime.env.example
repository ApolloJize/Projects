# Copy to .env and source it with: set -a; . ./.env; set +a
# Prefer config.json generated from Terraform for endpoints/OCIDs.
LAB_CONFIG=config.json
OCI_AUTH=instance_principal
OCI_CONFIG_PROFILE=HEALTHLAB
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..REPLACE
OCI_VAULT_OCID=ocid1.vault.oc1.iad.REPLACE
SECRET_PREFIX=healthlab
SQLMI_HOST=REPLACE.database.windows.net
SQLMI_DATABASE=healthsource
SYNAPSE_HOST=REPLACE.sql.azuresynapse.net
SYNAPSE_DATABASE=healthdw
# Use the full TLS LOW connection descriptor from terraform output.
ADW_DSN=REPLACE
# OCI GenAI availability is regional. Select a model supporting GenericChatRequest.
GENAI_REGION=us-chicago-1
GENAI_MODEL_ID=REPLACE_WITH_CURRENT_ON_DEMAND_MODEL_ID
# Existing confidential app in the OIC identity domain; grant ServiceInvoker.
OIC_TOKEN_URL=https://REPLACE.identity.oraclecloud.com/oauth2/v1/token
OIC_CLIENT_ID=REPLACE
OIC_CLIENT_SECRET_OCID=ocid1.vaultsecret.oc1.iad.REPLACE
OIC_SCOPE=REPLACE_WITH_OIC_RESOURCE_SCOPE
OIC_INTEGRATION_PATH=/ic/api/integration/v1/flows/rest/HEALTH_PROMOTE/1.0/promote
# Azure Terraform automation, alternative to az login. Export outside source control.
# ARM_TENANT_ID=...
# ARM_SUBSCRIPTION_ID=...
# ARM_CLIENT_ID=...
# ARM_CLIENT_SECRET=...   # or ARM_USE_OIDC=true with a federated assertion
