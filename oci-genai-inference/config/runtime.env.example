# Copy to .env, replace the required fields, then: set -a; . ./.env; set +a
# For an operator laptop, use ~/.oci/config's HEALTHLAB API-signing profile.
OCI_AUTH=api_key
OCI_CONFIG_PROFILE=HEALTHLAB
# On the existing OCI runner, set OCI_AUTH=instance_principal instead.
GENAI_REGION=us-chicago-1
GENAI_MODEL_ID=REPLACE_WITH_A_SUPPORTED_GENERIC_CHAT_MODEL_ID
# Pass --config ../azure-oci-health-lab/config.json to reuse Terraform outputs.
# Without that file, export these values yourself:
# OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..REPLACE
# OCI_REGION=us-ashburn-1
# OCI_VAULT_OCID=ocid1.vault.oc1.iad.REPLACE
# SECRET_PREFIX=healthlab
# ADW_DSN='REPLACE_WITH_THE_ADW_TLS_LOW_CONNECTION_DESCRIPTOR'
